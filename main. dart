import 'package:flutter/material.dart';
import 'package:flutter_inappwebview/flutter_inappwebview.dart';

void main() {
  runApp(const LyteboxApp());
}

class LyteboxApp extends StatelessWidget {
  const LyteboxApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      theme: ThemeData.dark(), // गेमिंग लुक के लिए डार्क थीम
      home: const LyteboxHomeScreen(),
    );
  }
}

class LyteboxHomeScreen extends StatefulWidget {
  const LyteboxHomeScreen({super.key});

  @override
  State<LyteboxHomeScreen> createState() => _LyteboxHomeScreenState();
}

class _LyteboxHomeScreenState extends State<LyteboxHomeScreen> {
  final TextEditingController _searchController = TextEditingController();
  final String _serverBaseUrl = "https://cdly-lamp-q9qr655wjw4f4qgw-3000.app.github.dev"; // आपका क्लाउड सर्वर लिंक

  final List<Map<String, String>> _games = [
    {"name": "BGMI Mobile", "fps": "90 FPS", "type": "Online Low-Data"},
    {"name": "Free Fire Max", "fps": "60 FPS", "type": "Offline Cache"},
    {"name": "GTA V Cloud", "fps": "60 FPS", "type": "Ultra-Low Latency"},
  ];

  List<Map<String, String>> _filteredGames = [];

  @override
  void initState() {
    super.initState();
    _filteredGames = _games;
  }

  void _filterGames(String query) {
    setState(() {
      _filteredGames = _games
          .where((game) => game['name']!.toLowerCase().contains(query.toLowerCase()))
          .toList();
    });
  }

  void _playGame(String gameName) {
    if (gameName.isEmpty) return;
    String gameUrl = "$_serverBaseUrl/play?game=${Uri.encodeComponent(gameName)}";
    
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => CloudGamePlayerScreen(gameName: gameName, gameUrl: gameUrl),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("⚡ LYTBOX LIVE ⚡"),
        centerTitle: true,
        backgroundColor: Colors.black,
      ),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        key: UniqueKey(),
        child: Column(
          children: [
            TextField(
              controller: _searchController,
              onChanged: _filterGames,
              decoration: InputDecoration(
                hintText: "Type game name (e.g. BGMI)...",
                prefixIcon: const Icon(Icons.search),
                suffixIcon: IconButton(
                  icon: const Icon(Icons.play_arrow, color: Colors.green),
                  onPressed: () => _playGame(_searchController.text),
                ),
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
              ),
            ),
            const SizedBox(height: 20),
            Expanded(
              child: ListView.builder(
                itemCount: _filteredGames.length,
                itemBuilder: (context, index) {
                  final game = _filteredGames[index];
                  return Card(
                    margin: const EdgeInsets.symmetric(vertical: 8),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                    child: ListTile(
                      leading: const Icon(Icons.bolt, color: Colors.amber, size: 32),
                      title: Text(game['name']!, style: const TextStyle(fontWeight: FontWeight.bold)),
                      subtitle: Text("${game['type']} | ${game['fps']}"),
                      trailing: ElevatedButton(
                        style: ElevatedButton.styleFrom(backgroundColor: Colors.green),
                        onPressed: () => _playGame(game['name']!),
                        child: const Text("PLAY"),
                      ),
                    ),
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class CloudGamePlayerScreen extends StatelessWidget {
  final String gameName;
  final String gameUrl;

  const CloudGamePlayerScreen({super.key, required this.gameName, required this.gameUrl});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text("Streaming: $gameName"),
        backgroundColor: Colors.black,
      ),
      body: InAppWebView(
        initialUrlRequest: URLRequest(url: WebUri(gameUrl)),
        initialSettings: InAppWebViewSettings(
          useWideViewPort: true,
          loadWithOverviewMode: true,
          javaScriptEnabled: true,
          supportZoom: false,
        ),
      ),
    );
  }
}